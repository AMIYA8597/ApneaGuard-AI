# Database configuration (Local SQLite or Neon Postgres)
# DATABASE_URL=sqlite:///./apneaguard.db
DATABASE_URL=postgresql://user:pass@ep-host.region.aws.neon.tech/neondb?sslmode=require

# CORS Configuration
# For local dev:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# For production, set to your Vercel URL:
# ALLOWED_ORIGINS=https://apneaguard-frontend.vercel.app

# GitHub Release URL for Model Binaries
# (e.g. https://github.com/your-username/ApneaGuard-AI/releases/download/v1.0/models.tar.gz)
MODEL_RELEASE_URL=

# Note: This project's core ML pipeline needs no external API keys at all.
# Placeholders for any later-needed keys:
# SOME_API_KEY=
